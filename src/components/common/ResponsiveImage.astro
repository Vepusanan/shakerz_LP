---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}
const {
  src,
  alt,
  sizes,
  widths = [320, 640, 960, 1280],
  priority = false,
  class: className,
} = Astro.props;
const candidates = [
  ...new Set([...widths.filter((width) => width <= src.width), src.width]),
].sort((a, b) => a - b);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={candidates}
  sizes={sizes}
  width={src.width}
  height={src.height}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class:list={['h-auto max-w-full', className]}
/>
